{
  "name": "flow-docs",
  "version": "0.2.0",
  "private": true,
  "displayName": "Flow Docs - Visual Project Documentation",
  "publisher": "UmeshSingh",
  "repository": {
    "type": "git",
    "url": "https://github.com/UmeshSingh2000/flow.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./src/extension/extension.cjs",
  "bin": {
    "flow": "./cli/flow.mjs"
  },
  "activationEvents": [
    "onCommand:flow.open",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "flow.open",
        "title": "Flow: Open"
      },
      {
        "command": "flow.linkWorkspace",
        "title": "Flow: Link Workspace to Active Project"
      },
      {
        "command": "flow.setupEverything",
        "title": "Flow: Set Up Everything (CLI + Claude)"
      },
      {
        "command": "flow.installCli",
        "title": "Flow: Install Terminal CLI"
      },
      {
        "command": "flow.installClaudeIntegration",
        "title": "Flow: Install Claude Integration"
      }
    ]
  },
  "description": "Flow — offline-first visual project documentation",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:extension": "npm run typecheck && vite build --base ./ --outDir .flow-extension/webview --emptyOutDir",
    "package": "node scripts/package-extension.mjs",
    "pretest": "rolldown tests/support/coreEntry.ts -f cjs -o .test-build/core.cjs -p node",
    "test": "node --test \"tests/**/*.test.cjs\"",
    "typecheck": "tsc --noEmit",
    "cli": "node cli/flow.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xyflow/react": "^13.0.2",
    "dompurify": "^3.4.18",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
